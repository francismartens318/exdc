{
    "extends": "recommended",
    "rules": {
        "ConstantAssertExpression": {
            "enabled": false
        },
        "FactoryMethodName": {
            "enabled": false
        },
        "JUnitPublicNonTestMethod": {
            "enabled": false
        },
        "LineLength": {
            "enabled": false
        },
        "MethodName": {
            "enabled": false
        },
        "MethodReturnTypeRequired": {
            "enabled": false
        },
        "NoDef": {
            "enabled": false
        },
        "PublicMethodsBeforeNonPublicMethods": {
            "enabled": false
        },
        "UnnecessaryGString": {
            "enabled": false
        },
        "UnnecessaryGetter": {
            "enabled": false
        },
        "VariableTypeRequired": {
            "enabled": false
        }
    }
}